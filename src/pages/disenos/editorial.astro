---
// Propuesta de diseño A: estilo editorial de despacho de abogados.
import '@fontsource-variable/fraunces';
import Base from '../../layouts/Base.astro';
import PresupuestoForm from '../../components/PresupuestoForm.astro';
import { servicios } from '../../data/servicios.js';
import { site } from '../../data/site.js';
const grupos = ['Administración', 'Derecho'];
---
<Base titulo="Diseño editorial" tema="tema-editorial" noindex>
  <section class="ed-hero">
    <div class="contenedor ed-hero__rejilla">
      <div>
        <p class="ed-sobre">Despacho en Madrid · Administración de fincas y derecho</p>
        <h1>Administración de fincas con <em>criterio jurídico</em>.</h1>
        <p class="ed-entradilla">Somos administradores de fincas y abogados expertos en propiedad horizontal. Llevamos su comunidad con la misma exigencia con la que llevamos un caso.</p>
        <div class="ed-acciones">
          <a class="ed-btn" href="#presupuesto">Solicitar presupuesto</a>
          <a class="ed-enlace" href={`tel:${site.telefonoLink}`}>o llámenos al {site.telefono}</a>
        </div>
      </div>
      <figure class="ed-hero__foto">
        <img src="/img/madrid.jpg" alt="Vista de los edificios del centro de Madrid" width="1920" height="1050" fetchpriority="high" />
        <figcaption>Madrid</figcaption>
      </figure>
    </div>
  </section>

  <section class="ed-credenciales">
    <div class="contenedor ed-credenciales__fila">
      <div><strong>25+</strong><span>años de colegiación como administradores de fincas</span></div>
      <div><strong>ICAM</strong><span>abogado colegiado nº 59437</span></div>
      <div><strong>ISDE</strong><span>dirección y docencia del Máster Inmobiliario</span></div>
      <div><strong>E&amp;J</strong><span>formación de administradores en Economist &amp; Jurist</span></div>
    </div>
  </section>

  <section class="ed-seccion">
    <div class="contenedor">
      <header class="ed-cabecera">
        <span class="ed-num">I</span>
        <h2>Servicios</h2>
        <p>Un único despacho para la gestión, el derecho y la técnica de su edificio.</p>
      </header>
      <div class="ed-indice">
        {grupos.map((g) => (
          <div>
            <h3 class="ed-grupo">{g}</h3>
            <ol>
              {servicios.filter((s) => s.grupo === g).map((s) => (
                <li>
                  <a href={`/servicios/${s.slug}/`}>
                    <span class="ed-indice__t">{s.titulo}</span>
                    <span class="ed-indice__d">{s.resumen}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ed-cita">
    <div class="contenedor">
      <blockquote>
        <p>“Hablamos su mismo idioma: claridad y sencillez, llamando a las cosas por su nombre.”</p>
        <cite>Nuestra forma de trabajar</cite>
      </blockquote>
    </div>
  </section>

  <section class="ed-seccion">
    <div class="contenedor">
      <header class="ed-cabecera">
        <span class="ed-num">II</span>
        <h2>Método</h2>
        <p>Tres compromisos que cumplimos con cada comunidad.</p>
      </header>
      <div class="ed-columnas">
        <article>
          <h3>Claridad</h3>
          <p>La gestión económica se hace con la cuenta de la comunidad, controlada por el presidente. Él recibe un informe semanal y cada propietario, uno trimestral y un resumen anual.</p>
        </article>
        <article>
          <h3>Proximidad</h3>
          <p>Visitas periódicas a la finca, canal de avisos 24 horas y atención personal de lunes a jueves de 9 a 18 y los viernes de 9 a 15.</p>
        </article>
        <article>
          <h3>Rigor</h3>
          <p>Preparamos cada junta con el presidente, levantamos actas con la transcripción literal de los acuerdos y los ejecutamos de inmediato.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ed-seccion ed-seccion--borde">
    <div class="contenedor">
      <header class="ed-cabecera">
        <span class="ed-num">III</span>
        <h2>Cambio de administrador</h2>
        <p>El acuerdo lo toma la junta por mayoría simple (art. 17.7 LPH). Del resto nos ocupamos nosotros.</p>
      </header>
      <ol class="ed-pasos">
        <li><span>01</span><h3>Presupuesto</h3><p>Estudiamos su comunidad y le enviamos una propuesta.</p></li>
        <li><span>02</span><h3>Junta</h3><p>Le ayudamos a preparar la convocatoria y el acuerdo.</p></li>
        <li><span>03</span><h3>Traspaso</h3><p>Pedimos actas, cuentas y contratos al administrador anterior.</p></li>
        <li><span>04</span><h3>Bienvenida</h3><p>Alta de los vecinos en TuComunidad y primera visita a la finca.</p></li>
      </ol>
      <p><a class="ed-enlace" href="/cambiar-de-administrador/">Leer la guía completa →</a></p>
    </div>
  </section>

  <section class="ed-seccion ed-contacto" id="presupuesto">
    <div class="contenedor ed-contacto__rejilla">
      <div>
        <span class="ed-num">IV</span>
        <h2>Hablemos de su comunidad</h2>
        <p>Cuéntenos cómo es y le enviaremos un presupuesto sin compromiso.</p>
        <dl class="ed-datos">
          <dt>Teléfono</dt><dd><a href={`tel:${site.telefonoLink}`}>{site.telefono}</a></dd>
          <dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          <dt>Despacho</dt><dd>{site.direccion}, {site.ciudad}</dd>
        </dl>
      </div>
      <PresupuestoForm />
    </div>
  </section>
</Base>

<style is:global>
  .tema-editorial {
    --rojo: #a8141a; --rojo-hover: #7f0f14; --rojo-suave: #f6e3df;
    --negro: #1d1416; --texto: #2a2123; --texto-suave: #6d6060;
    --crema: #f6f1e9; --borde: #ddd3c6; --radio: 2px;
    --serif: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
    background: var(--crema);
  }
  .tema-editorial h1, .tema-editorial h2, .tema-editorial h3 { font-family: var(--serif); font-weight: 500; letter-spacing: -.015em; }
  .tema-editorial .cabecera { background: rgba(246,241,233,.95); }
  .tema-editorial .barra-sup { background: #1d1416; }
  .tema-editorial .btn { border-radius: 2px; }
  .tema-editorial .formulario { background: #fffdf9; box-shadow: none; border-radius: 2px; }
  .tema-editorial .opcion, .tema-editorial .campo input, .tema-editorial .campo select, .tema-editorial .campo textarea { border-radius: 2px; }

  .ed-hero { padding: 72px 0 56px; }
  .ed-hero__rejilla { display: grid; grid-template-columns: 1.15fr .85fr; gap: 64px; align-items: end; }
  .ed-sobre { font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; color: var(--rojo); font-weight: 600; margin-bottom: 28px; }
  .ed-hero h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); line-height: 1.02; font-weight: 400; margin-bottom: 28px; }
  .ed-hero h1 em { font-style: italic; color: var(--rojo); }
  .ed-entradilla { font-size: 1.2rem; max-width: 34rem; color: var(--texto-suave); }
  .ed-acciones { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 32px; }
  .ed-btn { background: var(--negro); color: #fff; padding: 16px 28px; text-decoration: none; font-weight: 600; letter-spacing: .02em; }
  .ed-btn:hover { background: var(--rojo); color: #fff; }
  .ed-enlace { color: var(--negro); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--rojo); }
  .ed-hero__foto { margin: 0; }
  .ed-hero__foto img { aspect-ratio: 4/5; object-fit: cover; object-position: 38% center; width: 100%; filter: saturate(.85); }
  .ed-hero__foto figcaption { font-size: .8rem; color: var(--texto-suave); margin-top: 8px; font-style: italic; }

  .ed-credenciales { border-top: 1px solid var(--negro); border-bottom: 1px solid var(--borde); }
  .ed-credenciales__fila { display: grid; grid-template-columns: repeat(4, 1fr); }
  .ed-credenciales__fila div { padding: 28px 24px 28px 0; border-right: 1px solid var(--borde); margin-right: 24px; }
  .ed-credenciales__fila div:last-child { border-right: 0; }
  .ed-credenciales strong { display: block; font-family: var(--serif); font-size: 2.4rem; font-weight: 400; color: var(--negro); line-height: 1; margin-bottom: 8px; }
  .ed-credenciales span { font-size: .9rem; color: var(--texto-suave); }

  .ed-seccion { padding: 96px 0; }
  .ed-seccion--borde { border-top: 1px solid var(--borde); }
  .ed-cabecera { display: grid; grid-template-columns: 80px 1fr 1fr; gap: 24px; align-items: baseline; margin-bottom: 48px; border-bottom: 1px solid var(--negro); padding-bottom: 20px; }
  .ed-cabecera h2 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); }
  .ed-cabecera p { margin: 0; color: var(--texto-suave); }
  .ed-num { font-family: var(--serif); font-style: italic; color: var(--rojo); font-size: 1.4rem; }

  .ed-indice { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .ed-grupo { font-family: var(--fuente) !important; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--texto-suave); font-weight: 700 !important; }
  .ed-indice ol { list-style: none; padding: 0; margin: 0; counter-reset: ed; }
  .ed-indice li { counter-increment: ed; border-bottom: 1px solid var(--borde); }
  .ed-indice a { display: grid; grid-template-columns: 44px 1fr; gap: 4px 0; padding: 22px 0; text-decoration: none; color: inherit; }
  .ed-indice a::before { content: counter(ed, decimal-leading-zero); grid-row: span 2; font-family: var(--serif); color: var(--rojo); font-size: 1.05rem; }
  .ed-indice__t { font-family: var(--serif); font-size: 1.35rem; color: var(--negro); transition: color .15s; }
  .ed-indice__d { color: var(--texto-suave); font-size: .95rem; }
  .ed-indice a:hover .ed-indice__t { color: var(--rojo); }

  .ed-cita { background: var(--negro); color: #f6f1e9; padding: 96px 0; }
  .ed-cita blockquote { margin: 0 auto; max-width: 52rem; text-align: center; }
  .ed-cita p { font-family: var(--serif); font-size: clamp(1.6rem, 3.4vw, 2.6rem); line-height: 1.25; font-style: italic; font-weight: 300; }
  .ed-cita cite { font-style: normal; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; color: #c9a9a9; }

  .ed-columnas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
  .ed-columnas h3 { font-size: 1.6rem; border-top: 2px solid var(--rojo); padding-top: 16px; display: inline-block; }
  .ed-columnas p { color: var(--texto-suave); }

  .ed-pasos { list-style: none; padding: 0; margin: 0 0 32px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .ed-pasos span { font-family: var(--serif); font-size: 3rem; color: var(--rojo); line-height: 1; }
  .ed-pasos h3 { margin-top: 12px; font-size: 1.35rem; }
  .ed-pasos p { color: var(--texto-suave); }

  .ed-contacto { background: #efe7db; }
  .ed-contacto__rejilla { display: grid; grid-template-columns: .8fr 1.2fr; gap: 64px; align-items: start; }
  .ed-contacto h2 { font-size: clamp(2rem, 4vw, 3rem); margin-top: 8px; }
  .ed-datos { display: grid; grid-template-columns: auto 1fr; gap: 10px 24px; margin-top: 32px; }
  .ed-datos dt { font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--texto-suave); padding-top: 3px; }
  .ed-datos dd { margin: 0; }
  .ed-datos a { color: var(--negro); }

  @media (max-width: 960px) {
    .ed-hero__rejilla, .ed-indice, .ed-contacto__rejilla { grid-template-columns: 1fr; gap: 40px; }
    .ed-hero__foto img { aspect-ratio: 16/10; }
    .ed-credenciales__fila, .ed-pasos { grid-template-columns: 1fr 1fr; }
    .ed-columnas { grid-template-columns: 1fr; gap: 32px; }
    .ed-cabecera { grid-template-columns: 48px 1fr; }
    .ed-cabecera p { grid-column: 2; }
    .ed-seccion { padding: 64px 0; }
  }
  @media (max-width: 560px) {
    .ed-credenciales__fila, .ed-pasos { grid-template-columns: 1fr; }
    .ed-credenciales__fila div { border-right: 0; border-bottom: 1px solid var(--borde); margin-right: 0; padding: 20px 0; }
  }
</style>

---
// Propuesta de diseño B: moderno / digital, rejilla tipo "bento" y mucho contraste.
import '@fontsource-variable/plus-jakarta-sans';
import Base from '../../layouts/Base.astro';
import PresupuestoForm from '../../components/PresupuestoForm.astro';
import Icono from '../../components/Icono.astro';
import { servicios } from '../../data/servicios.js';
import { site } from '../../data/site.js';

const iconos = {
  'administracion-de-fincas': 'edificio',
  'administracion-y-gestion-de-alquileres': 'llave',
  secretaria: 'documento',
  'asesoria-juridica': 'balanza',
  'consultoria-derecho': 'lupa',
  'valoracion-inmobiliaria': 'casa',
  'asesoria-arquitectonica-e-industrial': 'regla',
};
const comparativa = [
  ['Administrador de fincas', 'Incluido', 'Contratas uno'],
  ['Reclamación extrajudicial a morosos', 'Sin coste', 'Pagas a un abogado'],
  ['Dudas sobre la Ley de Propiedad Horizontal', 'Sin coste', 'Pagas la consulta'],
  ['Consulta técnica sobre obras e instalaciones', 'Sin coste', 'Pagas a un técnico'],
  ['Informe económico al presidente', 'Cada semana', 'Depende del administrador'],
];
---
<Base titulo="Diseño moderno" tema="tema-moderno" noindex>
  <section class="mo-hero">
    <div class="contenedor mo-hero__rejilla">
      <div>
        <span class="mo-pastilla"><span class="mo-punto"></span> Administración de fincas en Madrid</span>
        <h1>Tu comunidad, gestionada. <span>Con abogados dentro.</span></h1>
        <p class="mo-sub">Administradores de fincas y abogados de propiedad horizontal en un solo equipo. Cuentas claras cada semana y morosos reclamados sin coste.</p>
        <ul class="mo-checks">
          <li><Icono nombre="check" size={18} /> Abogado colegiado {site.colegiado}</li>
          <li><Icono nombre="check" size={18} /> +25 años de colegiación</li>
          <li><Icono nombre="check" size={18} /> Avisos e incidencias 24 h</li>
        </ul>
      </div>
      <form class="mo-tarjeta" action="/contacto/#presupuesto" method="get">
        <p class="mo-tarjeta__titulo">Pide tu presupuesto</p>
        <label for="mo-viviendas">¿Cuántas viviendas y locales tiene tu comunidad?</label>
        <input id="mo-viviendas" name="viviendas" type="number" min="1" inputmode="numeric" placeholder="Ej. 24" required />
        <label for="mo-motivo">¿Qué necesitas?</label>
        <select id="mo-motivo" name="motivo">
          <option>Queremos cambiar de administrador</option>
          <option>Es una comunidad nueva</option>
          <option>Solo queremos comparar precios</option>
          <option>Tenemos un problema de morosidad o legal</option>
        </select>
        <button class="mo-btn" type="submit">Continuar <Icono nombre="flecha" size={18} /></button>
        <p class="mo-tarjeta__nota">Sin compromiso · o llámanos al <a href={`tel:${site.telefonoLink}`}>{site.telefono}</a></p>
      </form>
    </div>
  </section>

  <section class="mo-seccion">
    <div class="contenedor">
      <div class="mo-bento">
        <div class="mo-celda mo-celda--grande mo-celda--roja">
          <Icono nombre="balanza" size={36} />
          <h2>Un despacho de abogados también administra tu finca</h2>
          <p>Morosos, obras, conflictos entre vecinos o despidos de empleados: lo resolvemos sin que tengas que buscar a nadie más.</p>
        </div>
        <div class="mo-celda mo-celda--oscura">
          <span class="mo-dato">Semanal</span>
          <p>Informe económico al presidente. Trimestral y anual para cada propietario.</p>
        </div>
        <div class="mo-celda">
          <span class="mo-dato mo-dato--rojo">0 €</span>
          <p>Por la reclamación extrajudicial de impagos.</p>
        </div>
        <div class="mo-celda mo-celda--ancha">
          <Icono nombre="euro" size={28} />
          <h3>La cuenta es de tu comunidad</h3>
          <p>Trabajamos con la cuenta bancaria de la comunidad, controlada por el presidente. Y negociamos con los proveedores para bajar tu cuota.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mo-seccion mo-seccion--gris">
    <div class="contenedor">
      <div class="mo-titular">
        <h2>Todo en un mismo sitio</h2>
        <a class="mo-enlace" href="/servicios/">Ver todos los servicios <Icono nombre="flecha" size={18} /></a>
      </div>
      <div class="mo-servicios">
        {servicios.map((s) => (
          <a class="mo-servicio" href={`/servicios/${s.slug}/`}>
            <span class="mo-servicio__icono"><Icono nombre={iconos[s.slug]} size={26} /></span>
            <h3>{s.corto}</h3>
            <p>{s.resumen}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mo-seccion">
    <div class="contenedor">
      <div class="mo-titular">
        <h2>Lo que te ahorras</h2>
      </div>
      <div class="mo-tabla" role="table" aria-label="Comparativa: con Qfincas frente a contratar cada servicio por separado">
        <div class="mo-fila mo-fila--cab" role="row">
          <span role="columnheader"></span>
          <span role="columnheader" class="mo-col-q">Con Qfincas</span>
          <span role="columnheader">Por separado</span>
        </div>
        {comparativa.map(([c, q, o]) => (
          <div class="mo-fila" role="row">
            <span role="rowheader">{c}</span>
            <span role="cell" class="mo-col-q"><Icono nombre="check" size={18} /> {q}</span>
            <span role="cell" class="mo-gris">{o}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mo-seccion mo-seccion--negra">
    <div class="contenedor">
      <div class="mo-titular">
        <h2>¿Cambiar de administrador? En 4 pasos.</h2>
        <a class="mo-enlace mo-enlace--claro" href="/cambiar-de-administrador/">Cómo funciona <Icono nombre="flecha" size={18} /></a>
      </div>
      <ol class="mo-pasos">
        <li><span>1</span><h3>Presupuesto</h3><p>Nos cuentas cómo es tu comunidad.</p></li>
        <li><span>2</span><h3>Junta</h3><p>Los vecinos aprueban el cambio por mayoría simple.</p></li>
        <li><span>3</span><h3>Traspaso</h3><p>Pedimos toda la documentación al administrador anterior.</p></li>
        <li><span>4</span><h3>Listo</h3><p>Alta en TuComunidad y primera visita a la finca.</p></li>
      </ol>
    </div>
  </section>

  <section class="mo-seccion" id="presupuesto">
    <div class="contenedor mo-final">
      <div>
        <h2>Pide tu presupuesto</h2>
        <p class="mo-sub" style="color:var(--texto-suave)">Tres pasos y menos de un minuto.</p>
        <a class="mo-enlace" href={`tel:${site.telefonoLink}`}><Icono nombre="telefono" size={18} /> {site.telefono}</a>
      </div>
      <PresupuestoForm />
    </div>
  </section>
</Base>

<style is:global>
  .tema-moderno {
    --rojo: #e3141b; --rojo-hover: #c00f15; --rojo-suave: #fde7e7;
    --negro: #0f0a0b; --texto: #1d1718; --texto-suave: #6b6466; --borde: #e7e4e4;
    --radio: 20px;
    --fuente: 'Plus Jakarta Sans Variable', system-ui, sans-serif;
  }
  .tema-moderno h1, .tema-moderno h2, .tema-moderno h3 { letter-spacing: -.03em; font-weight: 800; }
  .tema-moderno .barra-sup { display: none; }
  .tema-moderno .cabecera { background: rgba(15,10,11,.92); border-bottom-color: #261c1d; }
  .tema-moderno .cabecera .menu a { color: #fff; }
  .tema-moderno .cabecera .menu .submenu a { color: var(--negro); }
  .tema-moderno .cabecera .btn--secundario { color: #fff; border-color: #4a3d3f; }
  .tema-moderno .cabecera .logo { background: #fff; padding: 6px 10px; border-radius: 12px; }
  .tema-moderno .cabecera .logo img { height: 38px; }
  .tema-moderno .boton-menu { color: #fff; }
  .tema-moderno .cabecera.abierta .menu { background: var(--negro); }
  .tema-moderno .cabecera.abierta .menu .submenu a { color: #fff; }
  .tema-moderno .formulario { border-radius: 24px; }

  .mo-hero { background: radial-gradient(1200px 500px at 85% 0%, #4a0d10 0%, transparent 60%), var(--negro); color: #fff; padding: 88px 0 104px; }
  .mo-hero__rejilla { display: grid; grid-template-columns: 1.2fr .8fr; gap: 56px; align-items: center; }
  .mo-pastilla { display: inline-flex; align-items: center; gap: 8px; border: 1px solid #3a2c2e; padding: 6px 14px; border-radius: 999px; font-size: .85rem; color: #d8cfd0; }
  .mo-punto { width: 8px; height: 8px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 4px rgba(61,220,132,.18); }
  .mo-hero h1 { color: #fff; font-size: clamp(2.6rem, 6.4vw, 5rem); line-height: .98; margin: 24px 0; }
  .mo-hero h1 span { color: var(--rojo); display: block; }
  .mo-sub { font-size: 1.15rem; color: #cfc6c7; max-width: 36rem; }
  .mo-checks { list-style: none; padding: 0; margin: 28px 0 0; display: flex; gap: 24px; flex-wrap: wrap; color: #e8e1e1; font-size: .95rem; }
  .mo-checks li { display: flex; align-items: center; gap: 8px; }
  .mo-checks svg { color: #3ddc84; }

  .mo-tarjeta { background: #fff; color: var(--texto); border-radius: 24px; padding: 28px; box-shadow: 0 30px 80px rgba(0,0,0,.45); display: grid; gap: 10px; }
  .mo-tarjeta__titulo { font-weight: 800; font-size: 1.3rem; margin: 0 0 6px; color: var(--negro); }
  .mo-tarjeta label { font-weight: 600; font-size: .9rem; margin-top: 6px; }
  .mo-hero__rejilla > *, .mo-final > * { min-width: 0; }
  .mo-tarjeta input, .mo-tarjeta select { width: 100%; min-width: 0; font: inherit; padding: 14px 16px; border: 1.5px solid var(--borde); border-radius: 14px; background: #faf9f9; }
  .mo-tarjeta input:focus, .mo-tarjeta select:focus { outline: 2px solid var(--rojo); border-color: var(--rojo); }
  .mo-btn { margin-top: 10px; display: flex; justify-content: center; align-items: center; gap: 8px; background: var(--rojo); color: #fff; border: 0; border-radius: 14px; padding: 16px; font: inherit; font-weight: 700; cursor: pointer; }
  .mo-btn:hover { background: var(--rojo-hover); }
  .mo-tarjeta__nota { font-size: .85rem; color: var(--texto-suave); text-align: center; margin: 4px 0 0; }

  .mo-seccion { padding: 88px 0; }
  .mo-seccion--gris { background: #f4f3f3; }
  .mo-seccion--negra { background: var(--negro); color: #e8e1e1; }
  .mo-seccion--negra h2, .mo-seccion--negra h3 { color: #fff; }
  .mo-titular { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 36px; }
  .mo-titular h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.8rem); }
  .mo-enlace { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--negro); text-decoration: none; }
  .mo-enlace:hover { color: var(--rojo); }
  .mo-enlace--claro { color: #fff; }

  .mo-bento { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(190px, auto); gap: 16px; }
  .mo-celda { background: #f4f3f3; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 8px; }
  .mo-celda p { margin: 0; color: var(--texto-suave); }
  .mo-celda h3 { margin: 8px 0 0; font-size: 1.2rem; }
  .mo-celda--grande { grid-column: span 2; grid-row: span 2; justify-content: flex-end; }
  .mo-celda--ancha { grid-column: span 2; }
  .mo-celda--roja { background: var(--rojo); color: #fff; }
  .mo-celda--roja h2 { color: #fff; font-size: clamp(1.6rem, 3vw, 2.3rem); margin: 16px 0 8px; }
  .mo-celda--roja p { color: #ffe1e1; font-size: 1.05rem; }
  .mo-celda--oscura { background: var(--negro); }
  .mo-celda--oscura p { color: #cfc6c7; }
  .mo-dato { font-size: 2.6rem; font-weight: 800; letter-spacing: -.04em; color: #fff; line-height: 1; margin-top: auto; }
  .mo-dato--rojo { color: var(--rojo); }

  .mo-servicios { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .mo-servicio { background: #fff; border-radius: 20px; padding: 24px; text-decoration: none; color: inherit; border: 1.5px solid transparent; transition: border-color .15s, transform .15s; }
  .mo-servicio:hover { border-color: var(--rojo); transform: translateY(-3px); color: inherit; }
  .mo-servicio__icono { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--rojo-suave); color: var(--rojo); margin-bottom: 16px; }
  .mo-servicio h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .mo-servicio p { color: var(--texto-suave); font-size: .95rem; margin: 0; }

  .mo-tabla { border: 1.5px solid var(--borde); border-radius: 24px; overflow: hidden; }
  .mo-fila { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 16px; padding: 18px 28px; border-top: 1px solid var(--borde); align-items: center; }
  .mo-fila--cab { border-top: 0; background: #f4f3f3; font-weight: 800; font-size: .95rem; }
  .mo-fila span[role="rowheader"] { font-weight: 600; }
  .mo-col-q { color: var(--rojo); font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .mo-fila--cab .mo-col-q { color: var(--negro); }
  .mo-gris { color: var(--texto-suave); }

  .mo-pasos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .mo-pasos li { background: #1d1517; border: 1px solid #2e2224; border-radius: 20px; padding: 24px; }
  .mo-pasos span { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--rojo); color: #fff; font-weight: 800; margin-bottom: 18px; }
  .mo-pasos p { color: #bfb5b6; margin: 0; }

  .mo-final { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: start; }
  .mo-final h2 { font-size: clamp(2rem, 4vw, 3rem); }

  @media (max-width: 960px) {
    .mo-hero__rejilla, .mo-final { grid-template-columns: 1fr; gap: 40px; }
    .mo-bento { grid-template-columns: 1fr 1fr; }
    .mo-celda--grande { grid-row: auto; }
    .mo-pasos { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .mo-hero { padding: 56px 0 72px; }
    .mo-bento, .mo-pasos { grid-template-columns: 1fr; }
    .mo-celda--grande, .mo-celda--ancha { grid-column: auto; }
    .mo-fila { grid-template-columns: 1fr 1fr; padding: 16px 18px; }
    .mo-fila span[role="rowheader"] { grid-column: 1 / -1; }
    .mo-fila--cab span:first-child { display: none; }
    .mo-seccion { padding: 64px 0; }
  }
</style>

---
// Propuesta de diseño C: cercano y vecinal. Colores melocotón y naranja de la paleta de la web actual.
import '@fontsource-variable/nunito';
import Base from '../../layouts/Base.astro';
import PresupuestoForm from '../../components/PresupuestoForm.astro';
import Icono from '../../components/Icono.astro';
import { servicios } from '../../data/servicios.js';
import { site } from '../../data/site.js';

const preguntas = [
  { p: '¿Cuánto cuesta?', r: 'Depende del tamaño de tu comunidad y de lo que necesitéis. Te preparamos un presupuesto cerrado y sin compromiso.' },
  { p: '¿Es complicado cambiar de administrador?', r: 'No. Lo aprueba la junta por mayoría simple y nosotros pedimos toda la documentación al administrador anterior.' },
  { p: '¿Y si hay una avería un domingo?', r: 'Tienes un canal de avisos 24 horas. Además, puedes comunicar averías y ver cómo van en TuComunidad.' },
];
---
<Base titulo="Diseño cercano" tema="tema-cercano" noindex>
  <section class="ce-hero">
    <div class="contenedor ce-hero__rejilla">
      <div>
        <span class="ce-etiqueta">Administración de fincas en Madrid</span>
        <h1>Tu comunidad tranquila. <span>Tus vecinos, también.</span></h1>
        <p class="ce-sub">Nos encargamos de las cuentas, las juntas, las averías y los papeles. Y como también somos abogados, de los problemas que vengan.</p>
        <div class="botones">
          <a class="btn btn--primario" href="#presupuesto">Quiero un presupuesto</a>
          <a class="btn btn--secundario" href={`tel:${site.telefonoLink}`}>Llamar al {site.telefono}</a>
        </div>
      </div>

      <svg class="ce-ilustracion" viewBox="0 0 440 400" role="img" aria-label="Ilustración de un edificio de viviendas con avisos de actas e informes enviados">
        <circle cx="230" cy="210" r="170" fill="#ffdcd0" />
        <rect x="120" y="70" width="200" height="290" rx="10" fill="#fff" stroke="#3a2626" stroke-width="3" />
        <rect x="105" y="58" width="230" height="22" rx="6" fill="#d71920" />
        <g fill="#f5efe9" stroke="#3a2626" stroke-width="2.5">
          <rect x="145" y="105" width="40" height="44" rx="4" /><rect x="200" y="105" width="40" height="44" rx="4" fill="#ffc9a8" /><rect x="255" y="105" width="40" height="44" rx="4" />
          <rect x="145" y="170" width="40" height="44" rx="4" fill="#ffc9a8" /><rect x="200" y="170" width="40" height="44" rx="4" /><rect x="255" y="170" width="40" height="44" rx="4" fill="#ffc9a8" />
          <rect x="145" y="235" width="40" height="44" rx="4" /><rect x="200" y="235" width="40" height="44" rx="4" fill="#ffc9a8" /><rect x="255" y="235" width="40" height="44" rx="4" />
        </g>
        <rect x="198" y="300" width="44" height="60" rx="4" fill="#ff7547" stroke="#3a2626" stroke-width="3" />
        <circle cx="232" cy="332" r="3" fill="#3a2626" />
        <line x1="60" y1="360" x2="390" y2="360" stroke="#3a2626" stroke-width="3" stroke-linecap="round" />
        <circle cx="365" cy="315" r="30" fill="#7fb38a" stroke="#3a2626" stroke-width="3" /><line x1="365" y1="345" x2="365" y2="360" stroke="#3a2626" stroke-width="3" />
        <g class="ce-burbuja ce-burbuja--1">
          <rect x="0" y="120" width="150" height="46" rx="23" fill="#fff" stroke="#3a2626" stroke-width="2.5" />
          <circle cx="24" cy="143" r="11" fill="#d71920" /><path d="M19 143.5l3.5 3.5 6-7" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <text x="42" y="148" font-size="14" font-weight="700" fill="#3a2626" font-family="Nunito Variable, sans-serif">Acta enviada</text>
        </g>
        <g class="ce-burbuja ce-burbuja--2">
          <rect x="280" y="20" width="160" height="46" rx="23" fill="#fff" stroke="#3a2626" stroke-width="2.5" />
          <circle cx="304" cy="43" r="11" fill="#ff7547" /><path d="M299 47v-6m5 6v-9m5 9v-4" stroke="#fff" stroke-width="2.5" stroke-linecap="round" />
          <text x="322" y="48" font-size="14" font-weight="700" fill="#3a2626" font-family="Nunito Variable, sans-serif">Informe semanal</text>
        </g>
      </svg>
    </div>
  </section>

  <section class="ce-seccion">
    <div class="contenedor">
      <h2 class="centrado">¿Quién eres?</h2>
      <div class="ce-perfiles">
        <a class="ce-perfil" href="/cambiar-de-administrador/">
          <span class="ce-perfil__icono"><Icono nombre="personas" size={30} /></span>
          <h3>Soy presidente o presidenta</h3>
          <p>Y queremos un administrador que nos dé las cuentas claras y responda al teléfono.</p>
          <span class="ce-perfil__mas">Cómo cambiar de administrador <Icono nombre="flecha" size={18} /></span>
        </a>
        <a class="ce-perfil" href="/vecinos/">
          <span class="ce-perfil__icono"><Icono nombre="casa" size={30} /></span>
          <h3>Soy vecino o vecina</h3>
          <p>Y quiero ver el acta de la última junta o avisar de una avería.</p>
          <span class="ce-perfil__mas">Entrar en el área de vecinos <Icono nombre="flecha" size={18} /></span>
        </a>
        <a class="ce-perfil" href="/servicios/administracion-y-gestion-de-alquileres/">
          <span class="ce-perfil__icono"><Icono nombre="llave" size={30} /></span>
          <h3>Tengo pisos en alquiler</h3>
          <p>Y quiero olvidarme de contratos, cobros y reparaciones.</p>
          <span class="ce-perfil__mas">Gestión de alquileres <Icono nombre="flecha" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="ce-seccion ce-seccion--melocoton">
    <div class="contenedor ce-notaras">
      <div>
        <h2>Lo que vas a notar desde el primer mes</h2>
        <p class="ce-sub">Nada de letra pequeña: así es como trabajamos con cada comunidad.</p>
      </div>
      <ul>
        <li><span><Icono nombre="grafica" /></span><div><strong>Cuentas que se entienden</strong><p>Informe semanal al presidente y trimestral a cada vecino.</p></div></li>
        <li><span><Icono nombre="campana" /></span><div><strong>Siempre hay alguien</strong><p>Canal de avisos 24 horas y atención personal entre semana.</p></div></li>
        <li><span><Icono nombre="escudo" /></span><div><strong>Morosos, sin dramas</strong><p>Los reclamamos por la vía extrajudicial sin coste para la comunidad.</p></div></li>
        <li><span><Icono nombre="euro" /></span><div><strong>Una cuota más ajustada</strong><p>Revisamos los contratos y negociamos descuentos con los proveedores.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="ce-seccion">
    <div class="contenedor">
      <h2>¿En qué te ayudamos?</h2>
      <div class="ce-chips">
        {servicios.map((s) => <a class="ce-chip" href={`/servicios/${s.slug}/`}>{s.corto}</a>)}
      </div>
    </div>
  </section>

  <section class="ce-seccion ce-seccion--crema">
    <div class="contenedor ce-dos">
      <div>
        <h2>Preguntas que nos hacen mucho</h2>
        <div class="preguntas">
          {preguntas.map((x) => <details><summary>{x.p}</summary><p>{x.r}</p></details>)}
        </div>
      </div>
      <div class="ce-quien">
        <h3>Quién hay detrás</h3>
        <p>Alberto Cano Alsúa, abogado y administrador de fincas con más de 25 años de colegiación, y María Galán. Además de llevar comunidades, forman a otros administradores en Economist &amp; Jurist y en el Máster Inmobiliario de ISDE.</p>
        <a href="/nosotros/">Conócenos →</a>
      </div>
    </div>
  </section>

  <section class="ce-seccion" id="presupuesto">
    <div class="contenedor ce-dos">
      <div>
        <h2>¿Hablamos?</h2>
        <p class="ce-sub">Cuéntanos cómo es tu comunidad y te enviamos un presupuesto sin compromiso. Si lo prefieres, llámanos y te atendemos en persona.</p>
        <p><a class="btn btn--secundario" href={`tel:${site.telefonoLink}`}>{site.telefono}</a></p>
      </div>
      <PresupuestoForm />
    </div>
  </section>
</Base>

<style is:global>
  .tema-cercano {
    --rojo: #d71920; --rojo-hover: #b3141a; --rojo-suave: #ffe9e1;
    --negro: #3a2626; --texto: #3a2626; --texto-suave: #7a6563; --borde: #f0dfd6;
    --crema: #fff6f1; --radio: 22px;
    --fuente: 'Nunito Variable', system-ui, sans-serif;
    background: #fffbf8;
  }
  .tema-cercano h1, .tema-cercano h2, .tema-cercano h3 { font-weight: 800; letter-spacing: -.01em; }
  .tema-cercano .barra-sup { background: #ffdcd0; color: var(--negro); }
  .tema-cercano .barra-sup a { color: var(--negro); }
  .tema-cercano .cabecera { background: rgba(255,251,248,.95); border-bottom-color: var(--borde); }
  .tema-cercano .formulario { border-radius: 26px; box-shadow: 0 12px 40px rgba(215,25,32,.08); }
  .tema-cercano .opcion, .tema-cercano .campo input, .tema-cercano .campo select, .tema-cercano .campo textarea { border-radius: 14px; }

  .ce-hero { padding: 56px 0 72px; overflow: hidden; }
  .ce-hero__rejilla { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .ce-etiqueta { display: inline-block; background: #ffdcd0; color: var(--rojo); font-weight: 800; padding: 6px 14px; border-radius: 999px; font-size: .88rem; }
  .ce-hero h1 { font-size: clamp(2.4rem, 5.6vw, 4.2rem); line-height: 1.05; margin: 20px 0; }
  .ce-hero h1 span { color: #ff7547; display: block; }
  .ce-sub { font-size: 1.15rem; color: var(--texto-suave); max-width: 34rem; }
  .ce-hero .botones { margin-top: 28px; }
  .ce-ilustracion { width: 100%; max-width: 520px; justify-self: center; overflow: visible; }
  .ce-burbuja { animation: flota 4s ease-in-out infinite; }
  .ce-burbuja--2 { animation-delay: -2s; }
  @keyframes flota { 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .ce-burbuja { animation: none; } }

  .ce-seccion { padding: 80px 0; }
  .ce-seccion--melocoton { background: #ffdcd0; }
  .ce-seccion--crema { background: var(--crema); }
  .ce-seccion h2 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); }

  .ce-perfiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; }
  .ce-perfil { background: #fff; border: 2px solid var(--borde); border-radius: 26px; padding: 28px; text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: border-color .15s, transform .15s; }
  .ce-perfil:hover { border-color: #ff7547; transform: translateY(-4px) rotate(-.4deg); color: inherit; }
  .ce-perfil__icono { width: 60px; height: 60px; border-radius: 18px; background: #ffdcd0; color: var(--rojo); display: grid; place-items: center; margin-bottom: 18px; }
  .ce-perfil h3 { font-size: 1.3rem; }
  .ce-perfil p { color: var(--texto-suave); }
  .ce-perfil__mas { margin-top: auto; color: var(--rojo); font-weight: 800; display: inline-flex; align-items: center; gap: 6px; }

  .ce-notaras { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: start; }
  .ce-notaras ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ce-notaras li { background: #fff; border-radius: 22px; padding: 22px; display: flex; gap: 16px; }
  .ce-notaras li > span { flex: none; width: 46px; height: 46px; border-radius: 14px; background: #fff1ea; color: #ff7547; display: grid; place-items: center; }
  .ce-notaras strong { display: block; font-size: 1.08rem; margin-bottom: 4px; }
  .ce-notaras p { margin: 0; color: var(--texto-suave); font-size: .95rem; }

  .ce-chips { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .ce-chip { padding: 14px 22px; border-radius: 999px; background: #fff; border: 2px solid var(--borde); color: var(--negro); text-decoration: none; font-weight: 700; transition: .15s; }
  .ce-chip:hover { background: var(--rojo); border-color: var(--rojo); color: #fff; }

  .ce-dos { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .ce-quien { background: #fff; border-radius: 26px; padding: 32px; border: 2px dashed #ffc9a8; }
  .ce-quien p { color: var(--texto-suave); }
  .ce-quien a { font-weight: 800; }

  @media (max-width: 960px) {
    .ce-hero__rejilla, .ce-notaras, .ce-dos { grid-template-columns: 1fr; }
    .ce-perfiles { grid-template-columns: 1fr; }
    .ce-ilustracion { max-width: 380px; }
  }
  @media (max-width: 560px) {
    .ce-notaras ul { grid-template-columns: 1fr; }
    .ce-seccion { padding: 56px 0; }
  }
</style>

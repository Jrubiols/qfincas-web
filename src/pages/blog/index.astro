---
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import Cta from '../../components/Cta.astro';
import { entradas } from '../../data/blog.js';
// Las preguntas de vecinos que había en el blog antiguo se han movido a /vecinos/.
---
<Base titulo="Blog" descripcion="Noticias de Qfincas y artículos sobre propiedad horizontal, juntas, morosidad y comunidades de propietarios.">
  <CabeceraPagina imagen="/img/s-secretaria.webp"
    titulo="Blog"
    lead="Noticias del despacho y artículos para entender mejor tu comunidad."
    migas={[{ label: 'Blog' }]}
  />
  <section class="seccion">
    <div class="contenedor">
      <div class="rejilla">
        {entradas.map((e) => (
          <a class="tarjeta tarjeta--enlace" href={`/blog/${e.slug}/`}>
            <span class="etiqueta">{e.tipo}{e.fecha && ` · ${e.fecha}`}</span>
            <h2 style="font-size:1.2rem">{e.titulo}</h2>
            <p>{e.resumen}</p>
            <span class="tarjeta__mas">Leer →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Cta />
</Base>

---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Cta from '../components/Cta.astro';

// Solo se enlazan los PDF que se han podido recuperar de la web antigua.
// Pendiente: pedir a Qfincas el resto de documentos si quieren publicarlos.
const documentos = [
  { t: 'Abogado colegiado', d: 'Colegio de Abogados de Madrid (ICAM), nº 59437', pdf: '/docs/certificado-abogado.pdf' },
  { t: 'Director del Máster Inmobiliario', d: 'ISDE · Instituto Superior de Derecho y Economía', pdf: '/docs/isde-director.pdf' },
  { t: 'Profesor del Máster Inmobiliario', d: 'ISDE · Instituto Superior de Derecho y Economía', pdf: '/docs/isde-profesor.pdf' },
];
const otros = [
  'Certificado profesional de administradores de fincas',
  'Certificado de no apertura de expediente disciplinario del Colegio de Administradores de Fincas de Madrid (2020)',
  'Director y profesora del área Executive de Economist & Jurist School (2019)',
  'Ponente en las Jornadas Prácticas UCP de Alcorcón, Alcobendas y Villalba (2016)',
];
const articulos = [
  'La impugnación de acuerdos de la comunidad de propietarios: cómo y por qué se puede impugnar un acuerdo',
  'Responsabilidad de la comunidad de propietarios cuando un vecino niega el acceso a su vivienda',
  'Nuevos sistemas para obtener ingresos en las comunidades de propietarios',
];
---
<Base titulo="Certificaciones" descripcion="Certificaciones profesionales de Qfincas: abogado colegiado ICAM, director y profesor del Máster Inmobiliario ISDE y docencia en Economist & Jurist.">
  <CabeceraPagina
    titulo="Certificaciones"
    lead="Nuestra experiencia está avalada por los colegios profesionales y por las instituciones donde enseñamos."
    migas={[{ label: 'Nosotros', href: '/nosotros/' }, { label: 'Certificaciones' }]}
  />
  <section class="seccion">
    <div class="contenedor">
      <div class="rejilla">
        {documentos.map((x) => (
          <a class="tarjeta tarjeta--enlace" href={x.pdf} target="_blank" rel="noopener">
            <span class="etiqueta">PDF</span>
            <h3>{x.t}</h3>
            <p>{x.d}</p>
            <span class="tarjeta__mas">Ver certificado →</span>
          </a>
        ))}
      </div>
      <div class="rejilla rejilla--2" style="margin-top:56px">
        <div>
          <h2 style="font-size:1.4rem">Otras acreditaciones</h2>
          <ul class="lista-check">{otros.map((o) => <li>{o}</li>)}</ul>
        </div>
        <div>
          <h2 style="font-size:1.4rem">Artículos en la revista Inmueble</h2>
          <ul class="lista-check">{articulos.map((o) => <li>{o}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>
  <Cta />
</Base>

---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base titulo="Solicitud recibida">
  <section class="seccion">
    <div class="contenedor prosa centrado" style="margin:0 auto">
      <h1>¡Gracias! Hemos recibido tu solicitud</h1>
      <p class="lead">Te responderemos en menos de 24 horas laborables con tu presupuesto o para pedirte algún dato que falte. Si es urgente, llámanos al <a href={`tel:${site.telefonoLink}`}>{site.telefono}</a>.</p>
      <p><a class="btn btn--primario" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>

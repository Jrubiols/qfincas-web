---
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import FranjaConfianza from '../../components/FranjaConfianza.astro';
import Cta from '../../components/Cta.astro';
import { servicios } from '../../data/servicios.js';
const grupos = ['Administración', 'Derecho'];
---
<Base titulo="Servicios" descripcion="Administración de fincas, gestión de alquileres, secretaría, asesoría jurídica, consultoría, valoración inmobiliaria y asesoría arquitectónica en Madrid.">
  <CabeceraPagina imagen="/img/madrid-800.webp"
    titulo="Servicios"
    lead="Un equipo multidisciplinar de administradores, abogados, arquitectos e ingenieros al servicio de tu comunidad."
    migas={[{ label: 'Servicios' }]}
  />
  {grupos.map((g, k) => (
    <section class={`seccion ${k ? 'seccion--crema' : ''}`}>
      <div class="contenedor">
        <h2>{g}</h2>
        <div class="rejilla" style="margin-top:24px">
          {servicios.filter((s) => s.grupo === g).map((s) => (
            <a class="tarjeta tarjeta--enlace" href={`/servicios/${s.slug}/`}>
              <img class="tarjeta__img" src={s.imagen} srcset={`${s.imagen.replace('.webp', '-480.webp')} 480w, ${s.imagen} 779w`} sizes="(max-width: 560px) 92vw, (max-width: 1240px) 45vw, 270px" alt="" loading="lazy" width="779" height="465" />
              <h3>{s.titulo}</h3>
              <p>{s.resumen}</p>
              <span class="tarjeta__mas">Ver servicio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
  <FranjaConfianza />

  <Cta />
</Base>

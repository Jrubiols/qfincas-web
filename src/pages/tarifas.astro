---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Cta from '../components/Cta.astro';

// PENDIENTE DE CONFIRMAR CON QFINCAS: qué incluye cada nivel y si se publica un precio "desde".
// El reparto de abajo es una propuesta basada en los 6 bloques de la web actual.
// Para poner precio, rellenar `precio` (ej. 'Desde 25 €/vivienda al mes').
const bloques = [
  'Contabilidad y pagos',
  'Secretaría y administración',
  'Recuperación de impagos sin coste',
  'Asesoría jurídica y fiscal',
  'Descuentos con proveedores',
  'Gestión integral del edificio',
  'Defensa judicial gratuita',
];
const planes = [
  { nombre: 'Esencial', para: 'Comunidades pequeñas que quieren las cuentas y las juntas al día.', incluye: 3, precio: null },
  { nombre: 'Completa', para: 'La opción de la mayoría de comunidades.', incluye: 5, precio: null, destacado: true },
  { nombre: 'Premier', para: 'Para quien quiere olvidarse de todo, también de los juicios.', incluye: 7, precio: null },
];

const detalle = [
  { t: 'Contabilidad y pagos', d: 'Recaudación de cuotas ordinarias y derramas, pago a proveedores e informe anual de gastos.' },
  { t: 'Secretaría y administración', d: 'Gestión del edificio, custodia de actas, contratos y documentos, visitas periódicas, convocatorias, asistencia a juntas y redacción de actas.' },
  { t: 'Recuperación de impagos', d: 'Reclamación extrajudicial sin coste para la comunidad, con un alto índice de recobro. Preparación del proceso judicial si hace falta.' },
  { t: 'Asesoría jurídica y fiscal', d: 'Te informamos de cómo gestionar la propiedad horizontal conforme a la ley vigente.' },
  { t: 'Descuentos', d: 'Descuentos y promociones que conseguimos de las empresas de mantenimiento y conservación.' },
  { t: 'Gestión integral del edificio', d: 'Plan de mantenimiento, búsqueda de financiación para obras, solicitud de ayudas y subvenciones, y consultas gratuitas a nuestros arquitectos e ingenieros.' },
];
---
<Base titulo="Tarifas de administración de fincas" descripcion="Tres tarifas de administración de fincas para que elijas la que mejor se adapta a tu comunidad. Puedes cambiar de tarifa en cualquier momento.">
  <CabeceraPagina
    titulo="Tarifas"
    lead="No todas las comunidades son iguales. Elige el nivel de servicio que necesitas y cámbialo cuando quieras, en cualquier momento del contrato."
    migas={[{ label: 'Tarifas' }]}
  />

  <section class="seccion">
    <div class="contenedor">
      <div class="planes">
        {planes.map((p) => (
          <div class={`plan ${p.destacado ? 'plan--destacado' : ''}`}>
            {p.destacado && <span class="plan__badge">La más elegida</span>}
            <h2 style="font-size:1.5rem">{p.nombre}</h2>
            <p style="color:var(--texto-suave)">{p.para}</p>
            <div class="plan__precio">{p.precio ? <strong>{p.precio}</strong> : <>Precio según el tamaño de tu comunidad</>}</div>
            <ul class="lista-check">
              {bloques.map((b, i) => <li class={i < p.incluye ? '' : 'no'}>{b}</li>)}
            </ul>
            <a class={`btn ${p.destacado ? 'btn--primario' : 'btn--secundario'}`} href={`/contacto/?tarifa=${p.nombre}#presupuesto`}>Pedir presupuesto</a>
          </div>
        ))}
      </div>
      <p class="centrado" style="margin-top:32px;color:var(--texto-suave)">Todas las tarifas incluyen atención personal, canal de avisos 24 horas y acceso de los vecinos a TuComunidad.</p>
    </div>
  </section>

  <section class="seccion seccion--crema">
    <div class="contenedor">
      <h2>Qué incluye cada servicio</h2>
      <div class="rejilla" style="margin-top:32px">
        {detalle.map((x) => (
          <div class="tarjeta"><h3>{x.t}</h3><p>{x.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <Cta titulo="¿Qué tarifa encaja con tu comunidad?" texto="Cuéntanos cuántas viviendas tiene y qué necesitáis, y te lo decimos sin compromiso." />
</Base>

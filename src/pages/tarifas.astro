---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import FranjaConfianza from '../components/FranjaConfianza.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site.js';

// Niveles iguales que en la plantilla de presupuesto, la hoja de tarifas y el informe para Alberto (25-10-2026).
// PENDIENTE DE CONFIRMAR CON QFINCAS:
//  - Precio "desde" de cada tarifa: rellenar `precio` cuando Alberto apruebe la tarifa por unidad.
//  - Subvenciones: si van incluidas en Premium o se cobran aparte. Aquí se muestran incluidas, como en la plantilla.
const planes = [
  {
    nombre: 'Base',
    para: 'Para comunidades pequeñas o presidentes que prefieren hacer ellos las gestiones: llevamos la contabilidad, los pagos y las cuentas del año.',
    precio: null,
    puntos: [
      'Contabilidad y pago a proveedores',
      'Informe anual de gastos y balance',
      'Custodia de la documentación y cambio de datos de los propietarios',
      'Nuestra red de reparadores de confianza',
    ],
  },
  {
    nombre: 'Media',
    para: 'Todo lo que exige la Ley de Propiedad Horizontal y lo que añadimos por experiencia. La que eligen la mayoría de comunidades.',
    precio: null,
    destacado: true,
    previo: 'Todo lo de Base, y además:',
    puntos: [
      'Recibos, cobro de cuotas y gestiones amistosas con morosos',
      'Presupuesto ordinario y contabilidad por partida doble',
      'Junta ordinaria: convocatoria, asistencia, acta y notificación de acuerdos',
      'Atención al presidente, averías y control de reparaciones',
      'Nóminas, seguros sociales e impuestos de la comunidad',
      'TuComunidad para todos los vecinos y móvil de contacto 24 horas',
    ],
  },
  {
    nombre: 'Premium',
    para: 'Para quien quiere olvidarse de todo: asuntos legales, morosos, obras y subvenciones.',
    precio: null,
    previo: 'Todo lo de Media, y además:',
    puntos: [
      'Una junta extraordinaria al año',
      'Extracto contable mensual a cada propietario',
      'Juicio a morosos sin coste de abogados',
      'Asesoramiento jurídico y fiscal integral',
      'Plan de mantenimiento y consultas a arquitectos',
      'Tramitación de subvenciones',
    ],
  },
];

// Desde qué tarifa se incluye cada servicio: 0 = Base, 1 = Media, 2 = Premium.
// `nota` sustituye al guion en las tarifas que no lo incluyen.
const tabla = [
  {
    grupo: 'Cuentas y cobros',
    filas: [
      { t: 'Contabilidad de la comunidad y pago a proveedores', desde: 0 },
      { t: 'Informe anual de gastos y balance', desde: 0 },
      { t: 'Emisión de recibos y presentación al banco de la comunidad', desde: 1 },
      { t: 'Gestiones amistosas de cobro a los morosos', desde: 1 },
      { t: 'Elaboración del presupuesto ordinario', desde: 1 },
      { t: 'Contabilidad por partida doble (Plan General de Contabilidad)', desde: 1 },
      { t: 'Extracto contable mensual a cada propietario', desde: 2 },
    ],
  },
  {
    grupo: 'Juntas',
    filas: [
      { t: 'Convocatoria y asistencia a la junta ordinaria', desde: 1 },
      { t: 'Secretario de la junta: redacción del acta', desde: 1 },
      { t: 'Notificación de los acuerdos de la junta ordinaria', desde: 1 },
      { t: 'Una junta extraordinaria al año', desde: 2 },
    ],
  },
  {
    grupo: 'Gestión diaria',
    filas: [
      { t: 'Custodia de la documentación de la comunidad', desde: 0 },
      { t: 'Cambio de datos de los propietarios', desde: 0 },
      { t: 'Red de reparadores de confianza', desde: 0 },
      { t: 'Atención al presidente para la gestión ordinaria de la comunidad', desde: 1 },
      { t: 'Averías e incidencias: aviso al reparador y seguimiento', desde: 1 },
      { t: 'Control de las reparaciones ordinarias y de sus facturas', desde: 1 },
      { t: 'Nóminas, seguros sociales e impuestos de la comunidad', desde: 1 },
      { t: 'TuComunidad: cuentas, actas y avisos desde el móvil', desde: 1, nota: '+0,50 € por vecino al mes' },
      { t: 'Móvil de contacto 24 horas', desde: 1 },
    ],
  },
  {
    grupo: 'Asuntos legales y edificio',
    filas: [
      { t: 'Juicio a morosos sin coste de abogados', desde: 2 },
      { t: 'Asesoramiento jurídico y fiscal integral', desde: 2 },
      { t: 'Plan de mantenimiento y tramitación de subvenciones', desde: 2 },
    ],
  },
];

// Preguntas que conviene hacer a cualquier administrador antes de elegirlo, con las respuestas de Qfincas.
const preguntas = [
  { p: '¿A nombre de quién está la cuenta del banco?', r: 'A nombre de la comunidad, y la controla el presidente. No pagamos ninguna factura sin el visto bueno de la junta de gobierno.' },
  { p: '¿Qué contabilidad lleva?', r: 'Partida doble según el Plan General de Contabilidad, no una lista de cobros y pagos. Comparamos cada gasto con el del año anterior y con el presupuesto aprobado.' },
  { p: '¿Cada cuánto informa al presidente?', r: 'Cada semana, con un informe económico. Cada propietario recibe además un informe trimestral y un resumen anual.' },
  { p: '¿Cuánto cuesta reclamar a un moroso?', r: 'En las tarifas Media y Premium, las gestiones amistosas de cobro van incluidas. En Premium, el juicio tampoco cuesta abogados a la comunidad: cobramos de las costas que paga el moroso.' },
  { p: '¿Quién elige a las empresas de las obras?', r: 'La junta. Pedimos presupuestos comparables y los analizamos, pero no participamos en la elección de contratistas ni proveedores.' },
  { p: '¿Tiene abogados en el despacho?', r: `Sí. Somos administradores de fincas y abogados colegiados en el Ilustre Colegio de la Abogacía de Madrid (${site.colegiado}).` },
  { p: '¿Está colegiado y asegurado?', r: `Sí. Estamos colegiados en el Colegio Profesional de Administradores de Fincas de Madrid (${site.colegiadoCaf}), con seguro de responsabilidad civil y una fianza que avala la gestión del dinero de la comunidad.` },
  { p: '¿Qué cobra aparte?', r: 'Te lo decimos por escrito antes de firmar, para que no haya sorpresas en la factura. Lo tienes justo debajo.' },
];

const aparte = [
  'Juntas extraordinarias, salvo una al año en Premium, y las juntas que acaban después de las 21:30 o se celebran en fin de semana o festivo.',
  'Presupuestos extraordinarios (derramas), inscripciones en el Registro de la Propiedad y legalización del libro de actas.',
  'Certificados que pide un propietario, como el de estar al corriente de pago para vender su piso, y sus gestiones particulares: se le cobran a él, no a la comunidad.',
  'Cambio de banco o de firmas, certificado digital de la comunidad y respuestas a requerimientos de la Administración.',
  'Siniestros con la aseguradora, mantenimientos obligatorios e inspecciones técnicas.',
  'Obras extraordinarias, licencias y subvenciones, salvo las que incluya Premium.',
  'Alquiler de zonas comunes, como la portería o la azotea, y sus declaraciones de Hacienda.',
  'Asuntos legales: apercibimientos, normas de régimen interior, contratos, denuncias y juicios distintos de la reclamación a morosos de Premium.',
  'Correos, burofax, fotocopias, tasas y notario, a su coste real y sin recargo.',
];
---
<Base titulo="Tarifas de administración de fincas" descripcion="Tres tarifas de administración de fincas, Base, Media y Premium, con todo lo que incluye cada una y lo que se cobra aparte. Pide presupuesto sin compromiso.">
  <CabeceraPagina imagen="/img/s-consultoria.webp"
    titulo="Tarifas"
    lead="No todas las comunidades son iguales. Elige el nivel de servicio que necesitas y cámbialo cuando quieras, en cualquier momento del contrato."
    migas={[{ label: 'Tarifas' }]}
  />

  <section class="seccion">
    <div class="contenedor">
      <div class="planes">
        {planes.map((p) => (
          <div class={`plan ${p.destacado ? 'plan--destacado' : ''}`}>
            {p.destacado && <span class="plan__badge">La más elegida</span>}
            <h2 style="font-size:1.5rem">{p.nombre}</h2>
            <p style="color:var(--texto-suave)">{p.para}</p>
            <div class="plan__precio">{p.precio ? <strong>{p.precio}</strong> : <>Precio según el tamaño de tu comunidad</>}</div>
            {p.previo && <p class="plan__previo">{p.previo}</p>}
            <ul class="lista-check">
              {p.puntos.map((x) => <li>{x}</li>)}
            </ul>
            <a class={`btn ${p.destacado ? 'btn--primario' : 'btn--secundario'}`} href={`/contacto/?tarifa=${p.nombre}#presupuesto`}>Pedir presupuesto</a>
          </div>
        ))}
      </div>
      <p class="centrado" style="margin-top:32px;color:var(--texto-suave)">Precios sin IVA, actualizados una vez al año con el IPC. Puedes cambiar de tarifa en cualquier momento.</p>
    </div>
  </section>

  <section class="seccion seccion--crema">
    <div class="contenedor">
      <h2>Qué incluye cada tarifa</h2>
      <p class="lead">Todo por escrito, para que lo compares punto por punto con tu administrador actual.</p>
      <div class="tabla-tarifas">
        <table>
          <caption class="solo-lector">Servicios incluidos en las tarifas Base, Media y Premium</caption>
          <thead>
            <tr>
              <th scope="col"><span class="solo-lector">Servicio</span></th>
              {planes.map((p) => <th scope="col" class={p.destacado ? 'destacada' : ''}>{p.nombre}</th>)}
            </tr>
          </thead>
          {tabla.map((g) => (
            <tbody>
              <tr class="grupo"><th scope="rowgroup" colspan="4">{g.grupo}</th></tr>
              {g.filas.map((f) => (
                <tr>
                  <th scope="row">{f.t}</th>
                  {planes.map((p, i) => (
                    <td class={p.destacado ? 'destacada' : ''}>
                      {i >= f.desde
                        ? <span class="si"><span class="solo-lector">Incluido</span></span>
                        : f.nota
                          ? <span class="nota">{f.nota}</span>
                          : <span class="no"><span class="solo-lector">No incluido</span></span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <span class="antetitulo">Compara antes de decidir</span>
      <h2>Ocho preguntas para cualquier administrador</h2>
      <p class="lead">Házselas a todos los despachos que te pasen presupuesto. Estas son nuestras respuestas.</p>
      <div class="rejilla rejilla--2" style="margin-top:32px">
        {preguntas.map((x) => (
          <div class="tarjeta"><h3>{x.p}</h3><p>{x.r}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion--crema" id="aparte">
    <div class="contenedor prosa">
      <h2>Lo que se factura aparte</h2>
      <p>Estos servicios no entran en la cuota mensual. Si los necesitas, te decimos el precio antes de hacerlos.</p>
      <ul>
        {aparte.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </section>

  <FranjaConfianza />

  <Cta titulo="¿Qué tarifa encaja con tu comunidad?" texto="Cuéntanos cuántas viviendas tiene y qué necesitáis, y te lo decimos sin compromiso." />
</Base>

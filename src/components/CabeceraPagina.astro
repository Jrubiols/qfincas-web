---
const { titulo, lead, migas = [] } = Astro.props;

// Migas de pan para Google (BreadcrumbList). La última miga es la página actual.
const base = Astro.site;
const items = [{ label: 'Inicio', href: '/' }, ...migas].map((m, i, todas) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: m.label,
  item: new URL(m.href ?? (i === todas.length - 1 ? Astro.url.pathname : '/'), base).href,
}));
const migasLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items };
---
<section class="cabecera-pagina">
  <div class="contenedor">
    <nav class="migas" aria-label="Estás en">
      <a href="/">Inicio</a>
      {migas.map((m) => <> · {m.href ? <a href={m.href}>{m.label}</a> : <span>{m.label}</span>}</>)}
    </nav>
    <h1>{titulo}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  {migas.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(migasLd)} />}
</section>
